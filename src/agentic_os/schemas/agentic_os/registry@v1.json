{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["agents"],
  "properties": {
    "agents": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label", "command"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "label": { "type": "string", "minLength": 1 },
          "command": {
            "type": "array",
            "items": { "type": "string" },
            "minItems": 1
          },
          "cwd_mode": {
            "type": "string",
            "enum": ["required", "optional", "ignored"]
          },
          "env": {
            "type": "object",
            "additionalProperties": { "type": "string" }
          },
          "stop_policy": { "type": "string", "enum": ["process_group"] },
          "health_command": {
            "type": "array",
            "items": { "type": "string" }
          },
          "version_command": {
            "type": "array",
            "items": { "type": "string" }
          },
          "config_fingerprint_command": {
            "type": "array",
            "items": { "type": "string" }
          },
          "attach_command": {
            "type": "array",
            "items": { "type": "string" }
          },
          "config_path": { "type": "string" },
          "workspace_roots": {
            "type": "array",
            "items": { "type": "string" }
          },
          "log_paths": {
            "type": "array",
            "items": { "type": "string" }
          },
          "default_provider": { "type": "string" },
          "model_arg": {
            "type": "array",
            "items": { "type": "string" }
          },
          "provider_env": { "type": "string" },
          "enabled": { "type": "boolean" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
