{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "agentic-os",
  "version": "1.0.1",
  "identifier": "dev.agentic-os.desktop",
  "build": {
    "frontendDist": "../../web",
    "devUrl": "http://127.0.0.1:5173",
    "beforeDevCommand": "bash ../../scripts/desktop-ui.sh start && bash ../../scripts/desktop-daemon.sh start",
    "beforeBuildCommand": "bash ../../scripts/prepare-desktop-bundle.sh"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "agentic-os",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self' customprotocol: asset:; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; script-src 'self'; style-src 'self'; font-src 'self' data:; img-src 'self' asset: http://asset.localhost data: blob:; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:* http://localhost:* https:; form-action 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "bundle-resources/agentic-os": "agentic-os"
    },
    "macOS": {
      "signingIdentity": "-"
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
